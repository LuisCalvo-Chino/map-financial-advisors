# Copia este archivo a .env.local y rellena con tu proyecto Firebase.
# Las variables VITE_* son las únicas expuestas al navegador (Vite).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Opcional: región de Cloud Functions (p. ej. southamerica-east1) si el callable falla con not-found
VITE_FIREBASE_FUNCTIONS_REGION=
VITE_GOOGLE_GMAIL_CLIENT_ID=
# URL del backend Node/Vercel (Gmail OAuth). En local: otra terminal `cd backend && npm run dev`
# En producción (GitHub Pages) debe ser la URL HTTPS pública de Vercel, no localhost.
VITE_GMAIL_BACKEND_URL=http://localhost:3000
