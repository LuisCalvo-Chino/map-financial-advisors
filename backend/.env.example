# Copia a .env.local y rellena. No subas secretos al repositorio.

# CORS: orígenes del front (Vite y GitHub Pages), separados por coma, sin barra final.
# ALLOWED_ORIGINS=http://localhost:5173,https://tu-usuario.github.io

# URI de redirección OAuth (misma que en Google Cloud). Obligatoria en producción para
# renovar tokens al procesar la cola / public-trigger si conectaste Gmail desde GitHub Pages.
# GMAIL_OAUTH_REDIRECT_URI=https://tu-usuario.github.io/tu-repo/gmail-oauth-callback.html

# GOOGLE_GMAIL_CLIENT_ID=
# GOOGLE_GMAIL_CLIENT_SECRET=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
